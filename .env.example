# Postgres connection string (never commit the real one)
DATABASE_URL="postgresql://user:password@localhost:5432/arrowfin_daily_snapshot"
PORT=3001
CORS_ORIGIN=http://localhost:3000
# Instant treated as "now" for the snapshot; the app clock starts here and advances in real time
SNAPSHOT_NOW=2026-08-25T14:30:00Z
API_KEY_TTL_HOURS=12
# Registers POST /dev/fills. Ignored when NODE_ENV=production.
DEV_FILLS_ENABLED=true
# Demo only: when set, the seed gives every trader this secret instead of random ones
# DEV_TRADER_SECRET=
# Serves the OpenAPI UI at /docs and the document at /docs-json. Ignored (off) when NODE_ENV=production.
SWAGGER_ENABLED=true
# Folder with the assessment CSVs (outside the repo)
DATASET_DIR=../dataset
# Socket.IO heartbeat: how often the server pings a client (ms)
WS_PING_INTERVAL_MS=25000
# How long a client may stay silent after a ping before it is dropped (ms)
WS_PING_TIMEOUT_MS=20000
# How long a handshake may take before the server gives up (ms)
WS_CONNECT_TIMEOUT_MS=45000
